#compute scenario x condition means and 95% CI
scenario_condition_summary <- belief_update %>%
group_by(scenario_label, work_condition) %>%
summarise(
mean_update   = mean(posterior_minus_prior, na.rm = TRUE),
sd_update     = sd(posterior_minus_prior, na.rm = TRUE),
n             = n(),
se_update     = sd_update / sqrt(n),
ci_lower      = mean_update - 1.96 * se_update,
ci_upper      = mean_update + 1.96 * se_update,
.groups = "drop"
) %>%
mutate(
work_condition = factor(
work_condition,
levels = c("both_alternate", "division_of_labor", "one_does_all")
)
)
#numeric check
cat("N rows:", nrow(scenario_condition_summary), "\n")  # expect 54
print(scenario_condition_summary %>% arrange(scenario_label, work_condition))
#raw trial-level data for individual points
belief_update_raw <- belief_update %>%
mutate(
work_condition = factor(
work_condition,
levels = c("both_alternate", "division_of_labor", "one_does_all")
)
)
#plot: faceted by scenario, one panel per scenario ----
#each panel shows the three conditions on x-axis,
#mean + CI as pointrange, raw points jittered behind
scenario_facet_plot <- ggplot(
scenario_condition_summary,
aes(x = work_condition, y = mean_update, color = work_condition)
) +
geom_hline(yintercept = 0, color = "grey60", linetype = "dashed", linewidth = 0.4) +
# Raw individual points behind
geom_jitter(
data = belief_update_raw,
aes(x = work_condition, y = posterior_minus_prior, color = work_condition),
width = 0.15, height = 0,
alpha = 0.3, size = 1.2,
inherit.aes = FALSE
) +
# Mean + 95% CI on top
geom_pointrange(
aes(ymin = ci_lower, ymax = ci_upper),
size = 0.6, linewidth = 0.8
) +
scale_color_manual(
values = c(
"both_alternate"    = "#008837",
"division_of_labor" = "#2166ac",
"one_does_all"      = "#e66101"
),
labels = condition_labels,
name   = "Condition"
) +
scale_x_discrete(labels = condition_labels) +
scale_y_continuous(breaks = scales::breaks_width(2)) +
facet_wrap(~ scenario_label, ncol = 6) +
labs(
x     = "Division of labor condition",
y     = "Belief update (posterior \u2212 prior)",
title = "Belief update by scenario and condition",
subtitle = "Point = mean, error bars = 95% CI; dots = individual trial ratings"
) +
theme_minimal(base_size = 11) +
theme(
plot.title       = element_text(face = "bold"),
panel.grid.minor = element_blank(),
strip.text       = element_text(face = "bold", size = 8),
axis.text.x      = element_text(angle = 30, hjust = 1, size = 7),
legend.position  = "bottom"
)
scenario_facet_plot
ggsave(
filename = file.path(output_dir, "exp2a_scenario_facet_plot.png"),
plot     = scenario_facet_plot,
width    = 16, height = 10, dpi = 300
)
