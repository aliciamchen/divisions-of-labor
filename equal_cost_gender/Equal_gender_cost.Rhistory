#scenario mean division of labor
scenario_dol <- belief_update %>%
filter(work_condition == "division_of_labor") %>%
group_by(scenario_label) %>%
summarise(
mean_update = mean(posterior_minus_prior, na.rm = TRUE),
sd_update   = sd(posterior_minus_prior, na.rm = TRUE),
n           = n(),
.groups = "drop"
) %>%
arrange(desc(mean_update))
cat("--- Scenario-level means (Division of Labor) ---\n")
print(scenario_dol)
#Participants level mean divison of laboor
participant_dol <- belief_update %>%
filter(work_condition == "division_of_labor") %>%
group_by(subject_id) %>%
summarise(
mean_update = mean(posterior_minus_prior, na.rm = TRUE),
sd_update   = sd(posterior_minus_prior, na.rm = TRUE),
n           = n(),
.groups = "drop"
) %>%
arrange(mean_update)
cat("\n--- Participant-level means (Division of Labor) ---\n")
print(participant_dol)
#comparison
cat("\n--- Range comparison ---\n")
cat("Scenario-level range:",
round(min(scenario_dol$mean_update), 3), "to",
round(max(scenario_dol$mean_update), 3), "\n")
cat("Participant-level range:",
round(min(participant_dol$mean_update), 3), "to",
round(max(participant_dol$mean_update), 3), "\n")
cat("Scenario SD of means:", round(sd(scenario_dol$mean_update), 3), "\n")
cat("Participant SD of means:", round(sd(participant_dol$mean_update), 3), "\n")
library(dplyr)
library(tidyr)
#One row per participant per scenario is expected
#belief_update = posterior_rating - prior_rating
participant_means <- pilot_data %>%
filter(
work_condition %in% c(
"both_alternate",
"division_of_labor",
"one_does_all"
),
!is.na(belief_update)
) %>%
group_by(subject_id, work_condition) %>%
summarise(
mean_belief_update = mean(belief_update),
.groups = "drop"
) %>%
pivot_wider(
names_from = work_condition,
values_from = mean_belief_update
) %>%
drop_na(
both_alternate,
division_of_labor,
one_does_all
)
library(dplyr)
library(tidyr)
participant_wide <- participant_means %>%
pivot_wider(
names_from = work_condition,
values_from = mean_belief_update
)
View(participant_wide)
effect_sizes <- participant_wide %>%
summarise(
n_participants = n(),
mean_diff_alt_dol = mean(alt_vs_dol),
sd_diff_alt_dol = sd(alt_vs_dol),
dz_alt_dol = abs(mean(alt_vs_dol) / sd(alt_vs_dol)),
mean_diff_alt_one = mean(alt_vs_one),
sd_diff_alt_one = sd(alt_vs_one),
dz_alt_one = abs(mean(alt_vs_one) / sd(alt_vs_one)),
mean_diff_dol_one = mean(dol_vs_one),
sd_diff_dol_one = sd(dol_vs_one),
dz_dol_one = abs(mean(dol_vs_one) / sd(dol_vs_one))
)
names(participant_means)
unique(participant_means$work_condition)
library(dplyr)
library(tidyr)
participant_wide <- participant_means %>%
pivot_wider(
names_from = work_condition,
values_from = mean_belief_update
)
names(participant_wide)
#comparison columns
participant_wide <- participant_wide %>%
mutate(
alt_vs_dol = both_alternate - division_of_labor,
alt_vs_one = both_alternate - one_does_all,
dol_vs_one = division_of_labor - one_does_all
)
names(participant_wide)
effect_sizes <- participant_wide %>%
summarise(
n_participants = sum(!is.na(alt_vs_dol)),
mean_diff_alt_dol = mean(alt_vs_dol, na.rm = TRUE),
sd_diff_alt_dol = sd(alt_vs_dol, na.rm = TRUE),
dz_alt_dol =
abs(mean(alt_vs_dol, na.rm = TRUE) /
sd(alt_vs_dol, na.rm = TRUE)),
mean_diff_alt_one = mean(alt_vs_one, na.rm = TRUE),
sd_diff_alt_one = sd(alt_vs_one, na.rm = TRUE),
dz_alt_one =
abs(mean(alt_vs_one, na.rm = TRUE) /
sd(alt_vs_one, na.rm = TRUE)),
mean_diff_dol_one = mean(dol_vs_one, na.rm = TRUE),
sd_diff_dol_one = sd(dol_vs_one, na.rm = TRUE),
dz_dol_one =
abs(mean(dol_vs_one, na.rm = TRUE) /
sd(dol_vs_one, na.rm = TRUE))
)
effect_sizes
savehistory("~/Downloads/MIT/LAB/equal_cost_gender/Equal_gender_cost.Rhistory")
