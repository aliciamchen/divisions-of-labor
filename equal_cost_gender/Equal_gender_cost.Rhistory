aes(x = stage_num), trim = FALSE, fill = "grey90", alpha = 0.6,
color = "grey60", linewidth = 0.4, side = "left"
) +
geom_violin(
data = scenario_accordion %>% filter(stage == "posterior"),
aes(x = stage_num), trim = FALSE, fill = "grey90", alpha = 0.6,
color = "grey60", linewidth = 0.4, side = "right"
) +
geom_line(
aes(group = scenario_label, color = direction),
alpha = 0.5, linewidth = 0.7
) +
geom_errorbar(
data = scenario_summary,
aes(x = stage_num, ymin = ci_lower, ymax = ci_upper),
inherit.aes = FALSE,
width = 0.06, color = "black", linewidth = 0.8
) +
geom_point(
data = scenario_summary,
aes(x = stage_num, y = mean_rating),
inherit.aes = FALSE,
color = "black", size = 2.5, shape = 18
) +
scale_color_manual(values = c("Increased" = "#e66101",
"Decreased" = "#008837",
"No change" = "#2166ac")) +
scale_x_continuous(breaks = c(0,1), labels = c("Prior","Posterior"),
limits = c(-0.6, 1.6)) +
scale_y_continuous(breaks = 0:6, limits = c(-0.5, 6.5)) +
facet_wrap(~ work_condition,
labeller = labeller(work_condition = condition_labels)) +
labs(
x     = NULL,
