"No change" = "#2166ac")) +
scale_x_continuous(breaks = c(0,1), labels = c("Prior","Posterior"),
limits = c(-0.6, 1.6)) +
scale_y_continuous(breaks = 0:6, limits = c(-0.5, 6.5)) +
facet_wrap(~ work_condition,
labeller = labeller(work_condition = condition_labels)) +
labs(
x     = NULL,
y     = "Perceived hierarchy\n(0 = Completely equal, 6 = Extremely hierarchical)",
title = title_text,
color = "Direction of update"
) +
theme_minimal(base_size = 13) +
theme(plot.title       = element_text(face = "bold"),
panel.grid.minor = element_blank(),
strip.text       = element_text(face = "bold"),
legend.position  = "bottom") +
guides(color = guide_legend(override.aes = list(alpha = 1, linewidth = 1.5)))
}
plot_participant <- make_accordion_plot(
participant_accordion,
group_var  = "subject_id",
title_text = "Belief update: mean per participant (averaged across scenarios)"
)
plot_participant
plot_scenario <- make_accordion_plot(
scenario_accordion,
group_var  = "scenario_label",
title_text = "Belief update: mean per scenario (averaged across participants)"
)
plot_scenario
make_accordion_plot <- function(data, group_var, title_text) {
ggplot(data, aes(x = stage_num, y = rating)) +
geom_violin(
data = data %>% filter(stage == "prior"),
aes(x = stage_num), trim = FALSE, fill = "grey90", alpha = 0.6,
color = "grey60", linewidth = 0.4, side = "left"
) +
geom_violin(
data = data %>% filter(stage == "posterior"),
aes(x = stage_num), trim = FALSE, fill = "grey90", alpha = 0.6,
color = "grey60", linewidth = 0.4, side = "right"
) +
geom_line(
aes(group = .data[[group_var]], color = direction),
alpha = 0.5, linewidth = 0.7
) +
scale_color_manual(values = c("Increased" = "#e66101",
"Decreased" = "#008837",
"No change" = "#2166ac")) +
scale_x_continuous(breaks = c(0,1), labels = c("Prior","Posterior"),
limits = c(-0.6, 1.6)) +
scale_y_continuous(breaks = 0:6, limits = c(-0.5, 6.5)) +
facet_wrap(~ work_condition,
labeller = labeller(work_condition = condition_labels)) +
labs(
x     = NULL,
y     = "Perceived hierarchy\n(0 = Completely equal, 6 = Extremely hierarchical)",
title = title_text,
color = "Direction of update"
) +
theme_minimal(base_size = 13) +
theme(plot.title       = element_text(face = "bold"),
panel.grid.minor = element_blank(),
strip.text       = element_text(face = "bold"),
legend.position  = "bottom") +
guides(color = guide_legend(override.aes = list(alpha = 1, linewidth = 1.5)))
}
plot_participant <- make_accordion_plot(
participant_accordion,
group_var  = "subject_id",
title_text = "Belief update: mean per participant (averaged across scenarios)"
)
plot_participant
plot_scenario <- make_accordion_plot(
scenario_accordion,
group_var  = "scenario_label",
title_text = "Belief update: mean per scenario (averaged across participants)"
)
plot_scenario
