group_by(work_condition, stage, stage_num) %>%
summarise(
mean_rating = mean(rating, na.rm = TRUE),
se_rating   = sd(rating, na.rm = TRUE) / sqrt(n()),
ci_lower    = mean_rating - 1.96 * se_rating,
ci_upper    = mean_rating + 1.96 * se_rating,
.groups = "drop"
)
print(scenario_summary)
#expect 6 rows (3 conditions x 2 stages)
